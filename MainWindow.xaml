<Window x:Class="SurfaceIrViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Surface Gesture Control" Width="720" Height="680" Closing="OnClosing">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock FontSize="23" FontWeight="SemiBold" Text="Surface Gesture Control"/>
  <StackPanel Grid.Row="1" Margin="0,10"><TextBlock TextWrapping="Wrap" Text="Experimental IR motion swipes. Select a mode, start the camera, then press F8 to enable or pause controls. Keep this window open and focus the app you want to control."/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Name="StartButton" Content="Start camera" Click="StartClick" Padding="12,5"/><Button Name="StopButton" Content="Stop camera" Click="StopClick" Padding="12,5" Margin="8,0"/><ComboBox Name="Mode" Width="210" SelectedIndex="0"><ComboBoxItem Content="Window: snap / min / max"/><ComboBoxItem Content="Browser: previous / next tab"/></ComboBox></StackPanel></StackPanel>
  <Border Grid.Row="2" Background="#161616" CornerRadius="5"><Image Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/></Border>
  <StackPanel Grid.Row="3" Margin="0,10"><TextBlock Name="Status" FontWeight="Bold" Text="Camera stopped. Controls paused."/><TextBlock Name="Gesture" Margin="0,5,0,0" Text="Gesture: none"/><TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Text="Window mode: horizontal swipes snap left/right; upward maximizes; downward minimizes. Browser mode: horizontal swipes change tabs. F8 pauses immediately. This detects motion, not a verified hand."/></StackPanel>
  <TextBlock Grid.Row="4" Foreground="#666" TextWrapping="Wrap" Text="Frames stay on this computer and are not saved. Camera access may be blocked by Windows settings or another app."/>
 </Grid>
</Window>
